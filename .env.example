# Optional Firebase (Google sign-in + Firestore sync). Leave empty to run without it.
# These are bundled into the browser code: never put a real secret behind VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# OWNER_ACCOUNTS: comma-separated Concordium testnet account addresses allowed to sign in
# with the browser wallet and change the gateway. Empty = every change is refused (503).
OWNER_ACCOUNTS=
# PORT: HTTP port (hosting platforms set it; default 3000).
PORT=
