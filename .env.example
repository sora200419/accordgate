# Optional Firebase (Google sign-in + Firestore sync). Leave empty to run without it.
# These are bundled into the browser code: never put a real secret behind VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# APP_URL: where the app is hosted (used for links and callbacks).
APP_URL=